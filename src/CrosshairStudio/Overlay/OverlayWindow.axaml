<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CrosshairStudio.Controls"
        x:Class="CrosshairStudio.Overlay.OverlayWindow"
        Title="Crosshair Overlay"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Width="96"
        Height="96"
        ShowActivated="False">
    <controls:CrosshairView x:Name="Visual"/>
</Window>
