<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CrosshairStudio.Overlay.MagnifierWindow"
        Title="Zoom"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Width="240"
        Height="240"
        ShowActivated="False">
    <Border CornerRadius="14" ClipToBounds="True" BorderBrush="#55FFFFFF" BorderThickness="1" Background="#CC111113">
        <Panel>
            <Image x:Name="Frame" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"/>
            <Border Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#80FFFFFF" BorderThickness="1" IsHitTestVisible="False"/>
            <Border x:Name="Grip"
                    Width="16" Height="16"
                    Margin="0,0,4,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#66FFFFFF"
                    CornerRadius="3"
                    IsVisible="False"
                    Cursor="BottomRightCorner"/>
        </Panel>
    </Border>
</Window>
