<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CrosshairStudio.ViewModels"
        xmlns:views="using:CrosshairStudio.Views"
        x:Class="CrosshairStudio.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="Root"
        Title="{Binding Loc[appName]}"
        Width="1280"
        Height="800"
        MinWidth="1040"
        MinHeight="680"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_OnKeyDown">

    <Border x:Name="Shell"
            CornerRadius="18"
            ClipToBounds="True"
            BorderBrush="#38FFFFFF"
            BorderThickness="1"
            Background="#111113">
        <Panel>
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="560" Height="560" Canvas.Left="-180" Canvas.Top="-240">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#26FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="480" Height="480" Canvas.Left="880" Canvas.Top="430">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#16FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="300" Height="300" Canvas.Left="700" Canvas.Top="-90">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <Grid RowDefinitions="48,*">
                <Border Background="Transparent" PointerPressed="TitleBar_OnPointerPressed">
                    <Grid ColumnDefinitions="*,Auto" Margin="16,0,10,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse Width="7" Height="7" Fill="#F5F5F7"/>
                            <TextBlock Text="{Binding Loc[appName]}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusText}" Classes="caption" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="chrome" Click="Minimize_Click" ToolTip.Tip="{Binding Loc[chromeMin]}">
                                <Rectangle Width="10" Height="1.6" Fill="#F5F5F7" RadiusX="1" RadiusY="1"/>
                            </Button>
                            <Button Classes="chrome" Click="Maximize_Click" ToolTip.Tip="{Binding Loc[chromeMax]}">
                                <Path Width="9" Height="9" Stretch="Uniform" Stroke="#F5F5F7" StrokeThickness="1.2"
                                      Data="M1.2,1.2 H7.8 V7.8 H1.2 Z"/>
                            </Button>
                            <Button Classes="chrome chrome-close" Click="Close_Click" ToolTip.Tip="{Binding Loc[chromeClose]}">
                                <Path Width="9" Height="9" Stretch="Uniform" Stroke="#F5F5F7" StrokeThickness="1.2"
                                      Data="M1.4,1.4 L7.6,7.6 M7.6,1.4 L1.4,7.6"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" IsVisible="{Binding !ShowOnboarding}" ColumnDefinitions="176,*" Margin="16,0,16,16">
                    <Border Classes="card" Margin="0,0,12,0" Padding="10">
                        <StackPanel Spacing="6">
                            <Button Classes="nav" Classes.active="{Binding IsCrosshairWorkspace}"
                                    Content="{Binding Loc[navCrosshair]}"
                                    Command="{Binding SelectWorkspaceCommand}"
                                    CommandParameter="Crosshair"/>
                            <Button Classes="nav" Classes.active="{Binding IsWidgetsWorkspace}"
                                    Content="{Binding Loc[navWidgets]}"
                                    Command="{Binding SelectWorkspaceCommand}"
                                    CommandParameter="Widgets"/>
                            <Button Classes="nav" Classes.active="{Binding IsWorkshopWorkspace}"
                                    Content="{Binding Loc[navWorkshop]}"
                                    Command="{Binding SelectWorkspaceCommand}"
                                    CommandParameter="Workshop"/>
                            <Button Classes="nav" Classes.active="{Binding IsSettingsWorkspace}"
                                    Content="{Binding Loc[navSettings]}"
                                    Command="{Binding SelectWorkspaceCommand}"
                                    CommandParameter="Settings"/>
                        </StackPanel>
                    </Border>
                    <Panel Grid.Column="1">
                        <views:CrosshairPage IsVisible="{Binding IsCrosshairWorkspace}" IsHitTestVisible="{Binding IsCrosshairWorkspace}"/>
                        <views:WidgetsPage IsVisible="{Binding IsWidgetsWorkspace}" IsHitTestVisible="{Binding IsWidgetsWorkspace}"/>
                        <views:WorkshopPage IsVisible="{Binding IsWorkshopWorkspace}" IsHitTestVisible="{Binding IsWorkshopWorkspace}"/>
                        <views:SettingsPage IsVisible="{Binding IsSettingsWorkspace}" IsHitTestVisible="{Binding IsSettingsWorkspace}"/>
                    </Panel>
                </Grid>
                <Border Grid.Row="1" IsVisible="{Binding ShowOnboarding}" Padding="36,20,36,28">
                    <views:OnboardingView DataContext="{Binding Onboarding}"/>
                </Border>
            </Grid>
        </Panel>
    </Border>
</Window>
